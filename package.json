{
  "name": "muranight",
  "version": "1.0.0",
  "description": "Extensao MV3 para aplicar modo noturno por URL exata (`origin + pathname + search`, ignorando `hash`) ou globalmente.",
  "main": "content.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/popup.tailwind.css -o ./popup.css --minify",
    "watch:css": "tailwindcss -i ./src/popup.tailwind.css -o ./popup.css --watch",
    "release:preflight": "node ./scripts/release/preflight.mjs",
    "release:zip": "node ./scripts/release/package.mjs",
    "release": "npm run release:preflight && npm run release:zip",
    "release:mark-submitted": "node ./scripts/release/mark-submitted.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@fontsource/open-sans": "^5.2.7",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17"
  }
}
